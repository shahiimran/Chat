rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function myRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isSignedIn() && myRole() == 'admin';
    }

    function isModerator() {
      return isSignedIn() && (myRole() == 'moderator' || myRole() == 'admin');
    }

    // A regular user may edit their own profile fields, but not the
    // privileged ones (role/isBanned/featured), and messageCount may only
    // move up by exactly 1 per write (normal "sent a message" increments).
    // .get(field, default) is used so this doesn't break on older docs
    // that predate one of these fields.
    function ownProfileEditIsSafe() {
      let reqData = request.resource.data;
      let oldData = resource.data;
      return reqData.get('role', 'user') == oldData.get('role', 'user')
          && reqData.get('isBanned', false) == oldData.get('isBanned', false)
          && reqData.get('featured', false) == oldData.get('featured', false)
          && (reqData.get('messageCount', 0) == oldData.get('messageCount', 0)
              || reqData.get('messageCount', 0) == oldData.get('messageCount', 0) + 1);
    }

    // ---------- username reservations (enforces uniqueness) ----------
    // doc id = lowercase username, data = { uid }. Read is public because the
    // register page needs to check availability before the visitor has an
    // account yet.
    match /usernames/{name} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if false; // immutable pointer — changed via delete + create
      allow delete: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
    }

    // ---------- users ----------
    match /users/{uid} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == uid
                    && request.resource.data.role == 'user'
                    && request.resource.data.isBanned == false;
      allow update: if isAdmin()
                    || (isSignedIn() && request.auth.uid == uid && ownProfileEditIsSafe());
      allow delete: if isAdmin() || (isSignedIn() && request.auth.uid == uid);
    }

    // ---------- friend requests ----------
    match /friendRequests/{id} {
      allow read: if isSignedIn() && (request.auth.uid == resource.data.from || request.auth.uid == resource.data.to);
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.from;
      allow update, delete: if isSignedIn() && (request.auth.uid == resource.data.from || request.auth.uid == resource.data.to);
    }

    // ---------- friends ----------
    match /friends/{id} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.users;
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.users;
      allow delete: if isSignedIn() && request.auth.uid in resource.data.users;
    }

    // ---------- notifications ----------
    match /notifications/{id} {
      allow read, update, delete: if isSignedIn() && request.auth.uid == resource.data.to;
      allow create: if isSignedIn();
    }

    // ---------- global chat ----------
    match /globalMessages/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.senderId;
      allow delete: if isSignedIn() && (request.auth.uid == resource.data.senderId || isModerator());
    }

    // ---------- named rooms ----------
    match /rooms/{roomId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin(); // rooms are only created via the admin approval flow

      match /messages/{msgId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && request.auth.uid == request.resource.data.senderId;
        allow delete: if isSignedIn() && (request.auth.uid == resource.data.senderId || isModerator());
      }
    }

    // ---------- room creation requests ----------
    match /roomRequests/{id} {
      allow read: if isSignedIn() && (request.auth.uid == resource.data.requestedBy || isAdmin());
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.requestedBy;
      allow update, delete: if isAdmin();
    }

    // ---------- private chats ----------
    // Admins can read (not write) any conversation for moderation oversight —
    // make sure this is disclosed in your Privacy Policy.
    match /chats/{chatId} {
      allow read: if isSignedIn() && (request.auth.uid in resource.data.participants || isAdmin());
      allow create, update: if isSignedIn() && request.auth.uid in request.resource.data.participants;

      match /messages/{msgId} {
        allow read: if isSignedIn() &&
                    (request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
                     || isAdmin());
        allow create: if isSignedIn()
                      && request.auth.uid == request.resource.data.senderId
                      && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
      }
    }

    // ---------- reports ----------
    match /reports/{id} {
      allow create: if isSignedIn();
      allow read, update, delete: if isModerator();
    }
  }
}
